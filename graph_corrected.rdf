    <ns1:starring rdf:resource="http://dbpedia.org/resource/Nadia_de_Lemeny"/>
    <ns1:starring rdf:resource="http://dbpedia.org/resource/Andrea_Arnold"/>
    <ns1:starring rdf:resource="http://dbpedia.org/resource/Richard_Addison"/>
    <ns1:releaseDate>1982-01-02</ns1:releaseDate>
