    <ns1:film rdf:resource="http://dbpedia.org/resource/We_Bought_a_Zoo"/>
    <ns1:film rdf:resource="http://dbpedia.org/resource/Almost_Famous"/>
    <ns1:film rdf:resource="http://dbpedia.org/resource/Aloha_(2015_film)"/>
    <rdfs:label>Cameron Crowe</rdfs:label>
    <ns2:rating>None</ns2:rating>
  </rdf:Description>
  <rdf:Description rdf:about="http://dbpedia.org/resource/The_Girl_from_U.N.C.L.E.">
    <ns1:director rdf:resource="http://dbpedia.org/resource/John_Brahm"/>
    <ns1:director rdf:resource="http://dbpedia.org/resource/Alf_Kjellin"/>
    <ns1:genre>http://dbpedia.org/resource/Action_fiction</ns1:genre>
    <ns1:abstract>The Girl from U.N.C.L.E. is an American spy fiction TV series starring Stefanie Powers that aired on NBC for one season from September 16, 1966, to April 11, 1967. The series was a spin-off from The Man from U.N.C.L.E. and used the same theme music composed by Jerry Goldsmith, in a different arrangement by Dave Grusin.</ns1:abstract>
