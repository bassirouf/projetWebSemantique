  <rdf:Description rdf:about="http://dbpedia.org/resource/Power_Rangers_Time_Force">
    <ns1:runtime rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1200.0</ns1:runtime>
    <ns1:genre>http://dbpedia.org/resource/Action_(genre)</ns1:genre>
