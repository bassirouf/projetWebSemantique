  <rdf:Description rdf:about="http://dbpedia.org/resource/The_Misadventures_of_Sheriff_Lobo">
    <ns1:abstract>The Misadventures of Sheriff Lobo is an American action comedy television series that ran on NBC from September 18, 1979, to May 5, 1981. For its second season the show was renamed Lobo. The program aired Tuesday nights, at 8:00 p.m. Eastern time. The lead character, Sheriff Elroy P. Lobo, played by Claude Akins, was a spin-off character from B. J. and the Bear, which also aired on NBC from 1979-1981.</ns1:abstract>
    <ns1:releaseDate>1979-09-18</ns1:releaseDate>
    <ns1:rating>N/A</ns1:rating>
    <rdfs:label>The Misadventures of Sheriff Lobo</rdfs:label>
    <ns1:runtime rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2880.0</ns1:runtime>
    <ns1:starring rdf:resource="http://dbpedia.org/resource/Brian_Kerwin"/>
