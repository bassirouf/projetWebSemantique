    <ns1:starring rdf:resource="http://dbpedia.org/resource/Masashi_Ishibashi_(actor)"/>
    <ns1:starring rdf:resource="http://dbpedia.org/resource/Yoshitaka_Tamba"/>
    <ns1:releaseDate>1977-04-09</ns1:releaseDate>
