  <rdf:Description rdf:about="http://dbpedia.org/resource/Joyzelle_Joyner">
    <rdfs:label>Joyzelle Joyner</rdfs:label>
    <ns1:film rdf:resource="http://dbpedia.org/resource/Whistlin'_Dan"/>
    <ns1:film rdf:resource="http://dbpedia.org/resource/The_House_of_Mystery_(1934_film)"/>
    <ns1:abstract>Joyzelle Joyner (August 27, 1905 – November 30, 1980) was an American actress and dancer. She appeared in at least thirty films between 1925 and 1935, garnering some notoriety for her appearance in The Sign of the Cross.</ns1:abstract>
    <ns2:rating>None</ns2:rating>
  </rdf:Description>
