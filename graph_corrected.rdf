    <ns1:starring rdf:resource="http://dbpedia.org/resource/Tina_Majorino"/>
    <ns1:starring rdf:resource="http://dbpedia.org/resource/Jerry_O'Connell"/>
    <rdfs:label>Camp Wilder</rdfs:label>
    <ns1:runtime rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1800.0</ns1:runtime>
    <ns1:releaseDate>1992-09-18</ns1:releaseDate>
    <ns2:rating>None</ns2:rating>
