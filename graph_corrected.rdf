    <ns1:film rdf:resource="http://dbpedia.org/resource/Jihad:_A_Story_of_the_Others"/>
    <rdfs:label>Deeyah Khan</rdfs:label>
    <ns2:rating>None</ns2:rating>
  </rdf:Description>
