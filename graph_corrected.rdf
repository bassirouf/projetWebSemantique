  <rdf:Description rdf:about="http://dbpedia.org/resource/Kamen_Rider_Agito">
    <ns1:starring rdf:resource="http://dbpedia.org/resource/Rina_Akiyama"/>
    <ns1:starring rdf:resource="http://dbpedia.org/resource/Yūsuke_Tomoi"/>
    <ns1:starring rdf:resource="http://dbpedia.org/resource/Toshiki_Kashu"/>
    <ns1:starring rdf:resource="http://dbpedia.org/resource/Takeshi_Masu"/>
